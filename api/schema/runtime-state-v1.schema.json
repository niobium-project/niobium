{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://niobium.dev/schema/runtime-state-v1.schema.json",
  "title": "runtime-state-v1",
  "$comment": "Wire shape for the corresponding versioned Niobium contract. Native validation additionally enforces UTF-8 byte limits, identity/reference uniqueness, digests, ownership and version relationships.",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1,
      "default": 1
    },
    "root_id": {
      "$ref": "#/$defs/root_id"
    },
    "product_id": {
      "$ref": "https://niobium.dev/schema/compiled-program-v1.schema.json#/$defs/id"
    },
    "generation": {
      "$ref": "https://niobium.dev/schema/compiled-program-v1.schema.json#/$defs/u64"
    },
    "release_sequence": {
      "$ref": "https://niobium.dev/schema/compiled-program-v1.schema.json#/$defs/u64"
    },
    "model_version": {
      "$ref": "https://niobium.dev/schema/compiled-program-v1.schema.json#/$defs/u32"
    },
    "program_sha256": {
      "$ref": "https://niobium.dev/schema/compiled-program-v1.schema.json#/$defs/sha256"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/value"
      },
      "minItems": 0,
      "maxItems": 64
    },
    "instances": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/instance"
      },
      "minItems": 0,
      "maxItems": 64
    },
    "migrations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/migration"
      },
      "minItems": 0,
      "maxItems": 64
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      },
      "maxItems": 64,
      "default": []
    }
  },
  "additionalProperties": false,
  "required": [
    "root_id",
    "product_id",
    "generation",
    "release_sequence",
    "model_version",
    "program_sha256",
    "inputs",
    "instances",
    "migrations"
  ],
  "$defs": {
    "root_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "value": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "https://niobium.dev/schema/compiled-program-v1.schema.json#/$defs/id"
        },
        "value": {
          "$ref": "https://niobium.dev/schema/compiled-program-v1.schema.json#/$defs/text"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "value"
      ]
    },
    "instance": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "https://niobium.dev/schema/compiled-program-v1.schema.json#/$defs/id"
        },
        "library_id": {
          "$ref": "https://niobium.dev/schema/compiled-program-v1.schema.json#/$defs/id"
        },
        "library_sha256": {
          "$ref": "https://niobium.dev/schema/compiled-program-v1.schema.json#/$defs/sha256"
        },
        "version": {
          "$ref": "https://niobium.dev/schema/compiled-program-v1.schema.json#/$defs/u32"
        },
        "data_hex": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2})*$",
          "maxLength": 32768,
          "$comment": "At most 16384 decoded state bytes."
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "library_id",
        "library_sha256",
        "version",
        "data_hex"
      ]
    },
    "migration": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "https://niobium.dev/schema/compiled-program-v1.schema.json#/$defs/id"
        },
        "owner": {
          "anyOf": [
            {
              "$ref": "https://niobium.dev/schema/compiled-program-v1.schema.json#/$defs/id"
            },
            {
              "const": "@product"
            }
          ]
        },
        "from": {
          "$ref": "https://niobium.dev/schema/compiled-program-v1.schema.json#/$defs/u32"
        },
        "to": {
          "$ref": "https://niobium.dev/schema/compiled-program-v1.schema.json#/$defs/u32"
        },
        "implementation_sha256": {
          "$ref": "https://niobium.dev/schema/compiled-program-v1.schema.json#/$defs/sha256"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "from",
        "to",
        "implementation_sha256"
      ]
    },
    "owner": {
      "type": "object",
      "properties": {
        "schema": {
          "const": 1,
          "default": 1
        },
        "product_id": {
          "$ref": "https://niobium.dev/schema/compiled-program-v1.schema.json#/$defs/id"
        },
        "root_id": {
          "$ref": "#/$defs/root_id"
        }
      },
      "additionalProperties": false,
      "required": [
        "product_id",
        "root_id"
      ]
    },
    "resource": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "https://niobium.dev/schema/compiled-program-v1.schema.json#/$defs/id"
        },
        "path": {
          "$ref": "https://niobium.dev/schema/compiled-program-v1.schema.json#/$defs/relative_path"
        },
        "sha256": {
          "$ref": "https://niobium.dev/schema/compiled-program-v1.schema.json#/$defs/sha256"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "sha256"
      ]
    }
  }
}
